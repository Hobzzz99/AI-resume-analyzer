# Base URL of the FastAPI service.
#
# Server-side only — deliberately not NEXT_PUBLIC_. The browser talks to this
# Next.js app's own origin, and the route handler in app/api/[...proxy] forwards
# to the service. That keeps the service address off the client and avoids a
# CORS preflight on every file upload.
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
