# =============================================================================
# resume-rag configuration
#
# Copy to `.env` and fill in GROQ_API_KEY and GROQ_MODEL. Everything else has a
# working default. `GET /api/v1/health` reports the values actually resolved at
# runtime, so you never have to guess what the running process is using.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="AI Resume Analyzer"
APP_VERSION=1.0.0
ENVIRONMENT=development           # development | production
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                     # false for human-readable local logs

# --- Storage paths -----------------------------------------------------------
DATA_DIR=./data
CHROMA_DIR=./data/chroma
MANIFEST_DIR=./data/manifests
UPLOAD_DIR=./data/uploads

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# --- Chunking ----------------------------------------------------------------
# These participate in the document fingerprint: changing them invalidates the
# cached index for every document, by design (see research.md R7).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=50                # chunks shorter than this are dropped as noise

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu              # cpu | cuda
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# --- Vector store ------------------------------------------------------------
COLLECTION_NAME=resume_rag_chunks
DISTANCE_METRIC=cosine            # cosine | l2 | ip

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_STRATEGY=hybrid         # similarity | mmr | bm25 | hybrid
TOP_K=5
FETCH_K=20                        # candidate pool for MMR / hybrid / reranking
MMR_LAMBDA=0.5                    # 1.0 = pure relevance, 0.0 = pure diversity
RRF_K=60                          # Reciprocal Rank Fusion constant
MIN_RETRIEVED_CHUNKS=2            # below this, fail with INSUFFICIENT_CONTEXT
MAX_CONTEXT_CHUNKS=24             # hard ceiling on chunks entering any prompt
MAX_CONTEXT_CHARS=24000           # hard ceiling on prompt context characters

# --- Reranking (optional; costs a second model download) ---------------------
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MULTIPLIER=4               # retrieve top_k * multiplier, then rerank

# --- LLM ---------------------------------------------------------------------
GROQ_API_KEY=                     # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1               # low: this is extraction, not creative writing
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2                 # repair attempts after a validation failure
LLM_RETRY_BACKOFF_SECONDS=1.0

# --- Prompts -----------------------------------------------------------------
PROMPT_TEMPLATE_DIR=./app/prompts/templates
DEFAULT_ANALYSIS_TEMPLATE=resume_analysis_v1
DEFAULT_CHAT_TEMPLATE=chat_qa_v1
REPAIR_TEMPLATE=repair_v1

# --- Caching -----------------------------------------------------------------
ENABLE_ANALYSIS_CACHE=true
ANALYSIS_CACHE_SIZE=128
ENABLE_QUERY_CACHE=true           # semantic cache in front of sub-query retrieval
QUERY_CACHE_SIZE=512
QUERY_CACHE_THRESHOLD=0.97        # cosine similarity required for a cache hit

# --- Chat --------------------------------------------------------------------
CHAT_MEMORY_TURNS=6
CHAT_SESSION_LIMIT=64
